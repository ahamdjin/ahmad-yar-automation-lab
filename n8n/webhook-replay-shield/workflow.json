{
  "name": "Webhook Replay Shield - Safe Single-Output Replay Filter",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-replay-shield",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "9e1ca241-81b4-4dc9-bd43-023c55e5f419",
      "name": "Receive Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -700,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body && typeof input.body === \"object\" && !Array.isArray(input.body) ? input.body : {};\nconst get = (a,b) => Object.prototype.hasOwnProperty.call(body,a) ? body[a] : body[b];\nconst id = typeof get(\"event_id\",\"eventId\") === \"string\" ? get(\"event_id\",\"eventId\").trim() : \"\";\nconst rawSource = get(\"source\",\"origin\");\nconst source = typeof rawSource === \"string\" ? rawSource.trim().toLowerCase() : \"\";\nconst errors = [];\nif (!/^[A-Za-z0-9][A-Za-z0-9._:-]{5,127}$/.test(id)) errors.push(\"event_id must be a stable string of 6-128 letters, numbers, dots, underscores, colons or hyphens\");\nif (!/^[a-z][a-z0-9._-]{1,39}$/.test(source)) errors.push(\"source must be a stable system name of 2-40 lowercase letters, numbers, dots, underscores or hyphens\");\nif (Object.keys(body).length > 30) errors.push(\"too many top-level fields\");\nconst valid = errors.length === 0;\nreturn [{json:{\n  valid,\n  eventId: valid ? id : null,\n  source: valid ? source : null,\n  eventKey: valid ? source + \":\" + id : null,\n  error: valid ? null : {code:\"invalid_event_envelope\",details:errors}\n}}];"
      },
      "id": "5f8edcd5-5f96-4e8c-aac9-2113262e0091",
      "name": "Validate Event Envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        40
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "735e892a-3b3c-4238-8f93-0f321e9988b0",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "ef0018ab-4914-444b-baa3-3d23bddfb519",
      "name": "Valid Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -200,
        40
      ]
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.eventKey }}",
        "options": {
          "scope": "node",
          "historySize": 10000
        },
        "logic": "removeItemsWithAlreadySeenKeyValues"
      },
      "id": "c85d1b03-cc9b-4789-8709-e80dbbe2b101",
      "name": "Remember Seen Event Keys",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        30,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const {eventId,source,eventKey}=$input.first().json;\nreturn [{json:{ok:true,status:\"accepted\",event_id:eventId,source,dedupe_key:eventKey,disposition:\"first_seen\",message:\"Key not present in the configured n8n deduplication history.\"}}];"
      },
      "id": "3cab9322-0fce-4249-b42b-6426c4d92a85",
      "name": "First Delivery Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
