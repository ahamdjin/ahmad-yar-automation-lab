      ]
    },
    {
      "parameters": {
        "jsCode": "const {error}=$input.first().json;\nreturn [{json:{ok:false,status:\"rejected\",error:error||{code:\"invalid_event_envelope\",details:[\"Invalid body\"]}}}];"
      },
      "id": "46eef853-a8dc-4b8e-ace4-ad1c700693c1",
      "name": "Reject Invalid Event",
